{
  "name": "@source-wire/local-runtime",
  "version": "0.1.0-alpha.2",
  "private": false,
  "description": "Experimental Source-Wire local runtime for synthetic or disposable local evaluation.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "agent-memory",
    "knowledge-provider",
    "mcp",
    "postgresql",
    "source-wire"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielJD1216/Source-Wire.git",
    "directory": "apps/alpha1-runtime"
  },
  "homepage": "https://github.com/DanielJD1216/Source-Wire#readme",
  "bugs": {
    "url": "https://github.com/DanielJD1216/Source-Wire/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "source-wire-local": "dist/src/cli/local.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./synthetic-provider": {
      "types": "./dist/src/knowledge-provider/synthetic-provider.d.ts",
      "import": "./dist/src/knowledge-provider/synthetic-provider.js"
    },
    "./replaceable-synthetic-provider": {
      "types": "./dist/src/knowledge-provider/replaceable-synthetic-adapter.d.ts",
      "import": "./dist/src/knowledge-provider/replaceable-synthetic-adapter.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist/src",
    "LICENSE",
    "migrations",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": "22.23.1"
  },
  "sourceWireCandidate": {
    "supportLevel": "experimental-alpha",
    "dataPolicy": "synthetic-or-disposable-only",
    "postgresql": "18.4",
    "postgresqlCompatibility": ["16.x"],
    "postgresqlCompatibilitySelection": "SOURCE_WIRE_POSTGRES_COMPATIBILITY_MAJOR=16",
    "mcpTransport": "stdio",
    "contractsPackage": "@source-wire/contracts@0.2.0",
    "knowledgeProviderContract": "knowledge-provider.v1",
    "sourceWireAccountRequired": false,
    "telemetryIncluded": false,
    "billingIncluded": false,
    "sourceWireEndpointRequired": false,
    "publicationSecurityReview": {
      "reviewedAt": "2026-07-25",
      "scope": "npm-public-alpha-0.1.0-alpha.2",
      "status": "approved-for-publication"
    },
    "advisoryDisposition": {
      "status": "temporarily-accepted",
      "advisory": "GHSA-frvp-7c67-39w9",
      "reviewBy": "2026-08-24",
      "reviewTriggers": [
        "dependency",
        "transport",
        "platform",
        "runtime",
        "publication",
        "hosting",
        "deployment",
        "data"
      ]
    },
    "unsupported": [
      "windows",
      "http-mcp",
      "sse-mcp",
      "static-serving",
      "production",
      "hosting",
      "deployment",
      "real-data",
      "live-providers"
    ]
  },
  "scripts": {
    "mcp": "node dist/src/mcp/server.js",
    "local": "node dist/src/cli/local.js",
    "operator": "node dist/src/cli/operator.js",
    "owner": "node dist/src/cli/owner.js",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@source-wire/contracts": "0.2.0",
    "@hono/node-server": "2.0.11",
    "@modelcontextprotocol/sdk": "1.29.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3"
  }
}
